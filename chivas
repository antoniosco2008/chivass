<style>
/* Layout: rojiblanco striped masthead, then stats strip, scorers with bars, match log, standings context. */
:root {
  --bg: #f4f5f7;
  --surface: #ffffff;
  --fg: #14171f;
  --muted: #5d6573;
  --line: #dde0e6;
  --red: #c8102e;
  --red-ink: #ffffff;
  --navy: #0d2a5c;
  --win: #1d7a46;
  --draw: #8a6d12;
  --loss: #b3261e;
  --stripe: #ffffff;
  --font-display: "Barlow Condensed", "Arial Narrow", sans-serif;
  --font-body: "Barlow", system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #11141b; --surface: #1a1e28; --fg: #eef0f4; --muted: #9aa3b2; --line: #2b3140;
    --red: #e23a52; --navy: #8fb0ee; --win: #5bd08a; --draw: #e0bf5a; --loss: #f08a82; --stripe: #1a1e28;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #11141b; --surface: #1a1e28; --fg: #eef0f4; --muted: #9aa3b2; --line: #2b3140;
  --red: #e23a52; --navy: #8fb0ee; --win: #5bd08a; --draw: #e0bf5a; --loss: #f08a82; --stripe: #1a1e28;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--fg);
  font-family: var(--font-body); font-size: 16px; line-height: 1.5;
}
.wrap {
  max-width: 920px; margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.mast {
  background: repeating-linear-gradient(90deg, var(--red) 0 28px, var(--stripe) 28px 56px);
  border-bottom: 4px solid var(--navy);
}
.mast .wrap { padding-block: 40px 28px; }
.mast h1 {
  display: inline-block; margin: 0; padding: 6px 16px 2px;
  background: var(--navy); color: #fff;
  font-family: var(--font-display); font-weight: 700; font-size: clamp(2.4rem, 8vw, 4rem);
  line-height: 1; text-transform: uppercase; letter-spacing: 0.02em; text-wrap: balance;
}
:root[data-theme="dark"] .mast h1 { background: #0d2a5c; }
.mast p {
  display: inline-block; margin: 10px 0 0; padding: 4px 12px;
  background: var(--surface); color: var(--fg); font-size: 0.95rem;
}
main { display: flex; flex-direction: column; gap: 40px; padding-block: 32px 48px; }
h2 {
  margin: 0 0 14px; font-family: var(--font-display); font-weight: 700;
  font-size: 1.6rem; text-transform: uppercase; letter-spacing: 0.04em; text-wrap: balance;
}
.sub { margin: -8px 0 14px; color: var(--muted); font-size: 0.92rem; max-width: 65ch; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }
.stat { background: var(--surface); border: 1px solid var(--line); padding: 12px 14px; min-width: 0; }
.stat .n { font-family: var(--font-display); font-weight: 700; font-size: 2.2rem; line-height: 1; font-variant-numeric: tabular-nums; }
.stat .l { margin-top: 4px; font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
.stat.hl .n { color: var(--red); }

.scorers { display: flex; flex-direction: column; gap: 8px; }
.row { display: grid; grid-template-columns: minmax(110px, 170px) 1fr 2ch; align-items: center; gap: 12px; }
.row .name { font-weight: 600; min-width: 0; overflow-wrap: anywhere; }
.row .bar { height: 22px; background: var(--line); }
.row .bar i { display: block; height: 100%; background: var(--red); }
.row.og .bar i { background: var(--muted); }
.row .g { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; text-align: right; font-variant-numeric: tabular-nums; }
.note { margin: 12px 0 0; color: var(--muted); font-size: 0.88rem; max-width: 65ch; }

.scroll { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); }
table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
th, td { padding: 9px 12px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
th { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); font-weight: 600; }
tr:last-child td { border-bottom: 0; }
td.sc { white-space: normal; min-width: 180px; color: var(--muted); font-size: 0.9rem; }
.pill { display: inline-block; min-width: 1.9em; padding: 1px 8px; text-align: center; font-weight: 600; font-size: 0.85rem; color: #fff; }
.pill.G { background: var(--win); } .pill.E { background: var(--draw); } .pill.P { background: var(--loss); }
:root:not([data-theme="light"]) .pill { color: #10131a; }
@media (prefers-color-scheme: light) { :root:not([data-theme="dark"]) .pill { color: #fff; } }
:root[data-theme="light"] .pill { color: #fff; }
tr.me td { font-weight: 600; background: color-mix(in srgb, var(--red) 10%, transparent); }
.src { color: var(--muted); font-size: 0.85rem; max-width: 65ch; }
.src a { color: var(--navy); }
a:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
@media (max-width: 520px) { .row { grid-template-columns: 96px 1fr 2ch; gap: 8px; } }
</style>

